# Modelo do .env de produção (docker-compose.yml). Copie para .env no
# servidor e preencha. O .env nunca vai para o Git. Passo a passo: docs/Deploy.md

# Domínio do sistema (sem https://). O DNS (registro A) precisa apontar para o IP do servidor.
DOMINIO=gabaro.exemplo.com.br

# Banco de dados. Gere senhas fortes, ex.: openssl rand -hex 24
PGUSER=postgres
PGPASSWORD=
PGDATABASE=expense_management

# Assinatura dos logins. Gere com: openssl rand -hex 32
# Trocar depois desconecta todo mundo (precisam entrar de novo).
JWT_SECRET_KEY=

# Admin criado só se o banco estiver vazio. Ao migrar dados existentes, não é usado.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cadastro público de construtoras (deixe false numa instalação para um cliente)
SIGNUP_ENABLED=false

# Backup diário. Hora em UTC (6 = 03:00 em Brasília); dias guardados no servidor e no Drive.
BACKUP_HORA_UTC=6
BACKUP_RETENCAO_DIAS=14
BACKUP_RETENCAO_REMOTA_DIAS=60
# Destino rclone da cópia externa, ex.: gdrive:gabaro-backups (vazio = só backup local)
RCLONE_DESTINO=
# Opcional: URL de ping (ex.: healthchecks.io) que avisa por e-mail se o backup parar
BACKUP_PING_URL=
