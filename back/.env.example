# Copie para back/.env e preencha. Nunca commite o .env com valores reais.

# Banco (PostgreSQL)
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGPORT=5432
PGDATABASE=expense_management
# Banco dedicado da suíte de testes (pytest); padrão expense_management_test
# TEST_PGDATABASE=expense_management_test

# Segredo do JWT — gere um valor longo e aleatório
JWT_SECRET_KEY=

# True = servidor de desenvolvimento do Flask com hot-reload
FLASK_DEBUG=False

# Origens permitidas, separadas por vírgula (ex.: https://app.cliente.com.br)
CORS_ALLOWED_ORIGINS=

# Admin inicial, criado só quando o banco está vazio. Sem ADMIN_PASSWORD,
# uma senha aleatória é gerada e escrita uma vez no log da inicialização.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cadastro público de novas construtoras (tela "Criar conta").
# Padrão desligado: numa instalação de cliente, o admin cria os usuários.
SIGNUP_ENABLED=false
